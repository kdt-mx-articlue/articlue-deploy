# ============================================================
# Articlue 배포 환경변수 — 이 파일을 .env 로 복사해서 값을 채우세요
#   cp .env.example .env
# .env 는 절대 커밋하지 않습니다 (.gitignore 등록됨)
# ============================================================

# ------------------------------------------------------------
# [필수] 접속 주소 — 브라우저 주소창에 치는 값 그대로 (끝에 / 없이)
#   CORS 허용 Origin, 카카오/네이버 OAuth Redirect URI 계산에 사용
#   예) http://123.45.67.89   /   https://articlue.example.com
# ------------------------------------------------------------
#   HTTP_PORT 를 80 이 아닌 값으로 바꾸면 주소에 포트를 붙입니다 (예: http://localhost:8080)
PUBLIC_ORIGIN=http://localhost

# ------------------------------------------------------------
# [선택] 외부 공개 방식
#   HTTP_BIND : 127.0.0.1 = 이 PC 안에서만 (터널·리버스 프록시용, 기본)
#               0.0.0.0   = 외부에서 바로 접속 (클라우드 VM 직접 공개, 방화벽 80 개방)
#   HTTP_PORT : 호스트 포트 (기본 80, 다른 프로그램이 80 을 쓰면 8080 등)
#   COMPOSE_PROFILES=tunnel : Cloudflare Tunnel 컨테이너 함께 실행
#     CLOUDFLARE_TUNNEL_TOKEN : Zero Trust → Networks → Tunnels → 터널 생성 후 토큰
#     터널 Public Hostname 서비스 주소: http://articlue-frontend:80
#     (ACC 등 다른 서비스와 같은 PC 라면 터널을 따로 만들거나 한 터널에 호스트명을 추가)
# ------------------------------------------------------------
HTTP_BIND=127.0.0.1
HTTP_PORT=80
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# [필수] Oracle DB (컨테이너가 최초 기동 시 자동 생성)
#   - ORACLE_SYS_PASSWORD : SYS/SYSTEM 관리자 비밀번호
#   - ORACLE_USER / ORACLE_PASSWORD : 앱 전용 계정 (스키마 소유자)
#   비밀번호를 바꾸려면 볼륨을 지우고 다시 만들어야 합니다 (docker compose down -v)
# ------------------------------------------------------------
ORACLE_SYS_PASSWORD=change-me-sys-password
ORACLE_USER=articlue
ORACLE_PASSWORD=change-me-app-password

# ------------------------------------------------------------
# [필수] OpenAI — 이력서 분석 / 자소서 생성 / 면접 / 공고 파싱
#   채용공고 벡터 DB 는 AI 이미지에 포함돼 있어 최초 기동 시 전체 파싱을 하지 않습니다
#   (벡터 DB 가 없을 때만 전체 파싱 — 소액 과금). 주간 수집 공고는 신규·변경분만 파싱
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
# 면접 최종 리포트 전용 모델 (면접 1회당 1번 호출, 질문별 피드백 품질)
INTERVIEW_REPORT_MODEL=gpt-4.1-mini

# ------------------------------------------------------------
# [선택] ElevenLabs — 보이스 면접(TTS/STT). 비워두면 보이스 모드만 동작 안 함
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=

# ------------------------------------------------------------
# [선택] 소셜 로그인 — 비워두면 이메일 회원가입/로그인만 사용
#   각 개발자 콘솔에 Redirect URI 로 아래 주소를 등록하세요
#     카카오 : ${PUBLIC_ORIGIN}/auth/kakao/callback
#     네이버 : ${PUBLIC_ORIGIN}/auth/naver/callback
#   KAKAO_REST_API_KEY 는 프론트 빌드에도 들어갑니다 (공개 키)
# ------------------------------------------------------------
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# GitHub OAuth App 의 Client ID (Device Flow 사용 — "Enable Device Flow" 체크 필요)
GITHUB_CLIENT_ID=

# ------------------------------------------------------------
# [선택] 배치 — DBR 아티클(매일 00:00) / 채용공고 수집(매주 월 04:00, 사람인·원티드·잡코리아)
#   - 배치는 백엔드 자식 프로세스로 돌아 실패해도 서버는 유지됩니다
#   - 실패 시: 코드 수정 후 재배포하면 기동 시 자동 보충 실행, 또는 관리자 화면에서 수동 실행
#   - ADMIN_TOKEN : 관리자 화면(${PUBLIC_ORIGIN}/admin/batch) 접속 토큰. 비우면 관리자 기능 비활성화
#   - 공고는 신규·변경분만 상세 수집 + AI 파싱 (소스당 최대 JOB_CRAWL_MAX_NEW_PER_SOURCE 건)
# ------------------------------------------------------------
ADMIN_TOKEN=
BATCH_ENABLED=true
JOB_CRAWL_CRON=0 4 * * 1
JOB_CRAWL_SOURCES=WANTED,SARAMIN,JOBKOREA
JOB_CRAWL_KEYWORDS=백엔드,프론트엔드,풀스택,데이터 엔지니어,AI 엔지니어
JOB_CRAWL_MAX_NEW_PER_SOURCE=20
# 1차 매칭 점수를 계산할 공고 수 (0 = 전체). GPT 정밀 분석은 항상 상위 5건만
MATCH_TOP_K=0

# ------------------------------------------------------------
# [선택] 모의 면접 이용 한도 — 면접 시작 API 에서 회원별 누적 세션 수로 검사
#   체험 계정('데모로 체험하기')은 DEMO_INTERVIEW_LIMIT 회, 음성(TTS) 면접 불가
# ------------------------------------------------------------
INTERVIEW_FREE_LIMIT=3
DEMO_INTERVIEW_LIMIT=2

# ------------------------------------------------------------
# [서버 배포용] CI가 Docker Hub 에 올린 이미지 위치
#   기존 scv3114/articlue-*:latest 는 건드리지 않고 :portfolio / :<커밋SHA> 태그만 사용
# ------------------------------------------------------------
IMAGE_REGISTRY=docker.io/scv3114
IMAGE_TAG=portfolio
# 서비스 하나만 다른 태그로 (롤백 등) — 비우면 IMAGE_TAG
AI_IMAGE_TAG=
BACKEND_IMAGE_TAG=
FRONTEND_IMAGE_TAG=
